@model ExamGuard.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Sign Up";
}

<div class="card card-custom p-4 bg-white shadow-sm mx-auto mt-3" style="max-width: 550px;">
    <div class="text-center mb-4">
        <div class="bg-success text-white d-inline-flex p-3 rounded-circle mb-2"><i class="bi bi-person-plus-fill fs-4"></i></div>
        <h4 class="fw-bold">Create an Account</h4>
        <p class="text-muted small">Register as a Faculty Member or Teaching Assistant (TA)</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

    <form asp-action="Register" method="post">
        <div class="row g-3 mb-3">
            <div class="col-md-12">
                <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Muhammad Muwahid Cheema" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="EmployeeOrRollNumber" class="form-label fw-semibold">Employee / Roll No.</label>
                <input asp-for="EmployeeOrRollNumber" class="form-control" placeholder="BSEF24M040" />
                <span asp-validation-for="EmployeeOrRollNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Department" class="form-label fw-semibold">Department</label>
                <select asp-for="Department" class="form-select">
                    <option value="">Select Department...</option>
                    <option value="Software Engineering">Software Engineering</option>
                    <option value="Computer Science">Computer Science</option>
                    <option value="Information Technology">Information Technology</option>
                </select>
                <span asp-validation-for="Department" class="text-danger small"></span>
            </div>
            <div class="col-md-12">
                <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="name@pucit.edu.pk" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Role" class="form-label fw-semibold">Designation</label>
                <select asp-for="Role" class="form-select">
                    <option value="TA">Teaching Assistant (TA)</option>
                    <option value="Faculty">Faculty Member</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">Register Account</button>
    </form>

    <hr class="my-3">
    <div class="text-center small">
        Already registered? <a asp-action="Login" class="text-decoration-none fw-bold">Sign In</a>
    </div>
</div>