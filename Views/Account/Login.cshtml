@model ExamGuard.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="card card-custom p-4 bg-white shadow-sm mx-auto mt-4" style="max-width: 450px;">
    <div class="text-center mb-4">
        <div class="bg-primary text-white d-inline-flex p-3 rounded-circle mb-2"><i class="bi bi-lock-fill fs-4"></i></div>
        <h4 class="fw-bold">Welcome Back</h4>
        <p class="text-muted small">Sign in to access your ExamGuard portal</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

    <form asp-action="Login" method="post">
        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
            <input asp-for="Email" class="form-control" placeholder="e.g. bsef24m040@pucit.edu.pk" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-semibold">Password</label>
            <input asp-for="Password" class="form-control" placeholder="••••••••" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
            </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Sign In</button>
    </form>

    <div class="alert alert-light border mt-3 mb-0 small">
        <strong>Demo Credentials:</strong><br />
        Admin: <code>admin@pucit.edu.pk</code> / <code>Admin@123</code><br />
        TA: <code>bsef24m040@pucit.edu.pk</code> / <code>User@123</code>
    </div>

    <hr class="my-3">
    <div class="text-center small">
        Don't have an account? <a asp-action="Register" class="text-decoration-none fw-bold">Sign Up</a>
    </div>
</div>