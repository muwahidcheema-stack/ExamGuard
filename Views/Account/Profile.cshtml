@model ExamGuard.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="card card-custom p-4 bg-white shadow-sm mx-auto mt-3" style="max-width: 550px;">
    <div class="text-center mb-4">
        <div class="bg-primary text-white d-inline-flex p-3 rounded-circle mb-2">
            <i class="bi bi-person-lines-fill fs-4"></i>
        </div>
        <h4 class="fw-bold">My Profile</h4>
        <p class="text-muted small">Update your personal and department information</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

    <form asp-action="Profile" method="post">
        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold">Email Address (Read-only)</label>
            <input asp-for="Email" class="form-control bg-light" readonly />
        </div>
        <div class="mb-3">
            <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="EmployeeOrRollNumber" class="form-label fw-semibold">Employee / Roll No.</label>
                <input asp-for="EmployeeOrRollNumber" class="form-control" />
                <span asp-validation-for="EmployeeOrRollNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Department" class="form-label fw-semibold">Department</label>
                <select asp-for="Department" class="form-select">
                    <option value="Software Engineering">Software Engineering</option>
                    <option value="Computer Science">Computer Science</option>
                    <option value="Information Technology">Information Technology</option>
                </select>
                <span asp-validation-for="Department" class="text-danger small"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Save Changes</button>
    </form>
</div>