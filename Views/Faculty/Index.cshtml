@model ExamGuard.ViewModels.FacultyDashboardViewModel
@{
    ViewData["Title"] = "Faculty / TA Dashboard";
}

<div id="facultyAlert" class="alert alert-success alert-dismissible fade show d-none small" role="alert">
    <span id="facultyAlertText"></span>
    <button type="button" class="btn-close" onclick="$('#facultyAlert').addClass('d-none')"></button>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Welcome, @Model.CurrentUser.FullName</h3>
        <p class="text-muted small">@Model.CurrentUser.EmployeeOrRollNumber • @Model.CurrentUser.Department Department</p>
    </div>
    <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#openSwapBoardModal">
        <i class="bi bi-card-list me-1"></i>Open Swap Board (@Model.OpenSwapBoard.Count)
    </button>
</div>

<!-- My Assigned Duties -->
<div class="card card-custom bg-white mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-calendar3 me-2 text-primary"></i>My Assigned Invigilation Duties</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Exam Details</th>
                    <th>Date & Time</th>
                    <th>Venue</th>
                    <th>Duty Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.MyDuties.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">You currently have no assigned invigilation duties.</td></tr>
                }
                else
                {
                    foreach (var duty in Model.MyDuties)
                    {
                        <tr>
                            <td><strong>@duty.Exam?.CourseCode - @duty.Exam?.CourseName</strong></td>
                            <td>
                                @duty.Exam?.ExamDate.ToString("MMM dd, yyyy")<br>
                                <small class="text-muted">@duty.Exam?.StartTime - @duty.Exam?.EndTime</small>
                            </td>
                            <td><span class="badge bg-dark">@duty.Exam?.Venue</span></td>
                            <td id="status-cell-@duty.DutyId">
                                @if (duty.Status == "SwapRequested")
                                {
                                    <span class="badge badge-status-pending">Swap Requested</span>
                                }
                                else
                                {
                                    <span class="badge badge-status-assigned">Confirmed</span>
                                }
                            </td>
                            <td id="action-cell-@duty.DutyId">
                                @if (duty.Status == "Assigned")
                                {
                                    <button class="btn btn-sm btn-warning"
                                            onclick="openSwapModal(@duty.DutyId, '@duty.Exam?.CourseCode - @duty.Exam?.CourseName')"
                                            data-bs-toggle="modal"
                                            data-bs-target="#requestSwapModal">
                                        <i class="bi bi-arrow-left-right me-1"></i>Request Swap
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled>Swap Pending...</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Incoming Swaps & Swap History -->
<div class="row g-4">
    <div class="col-md-6">
        <div class="card card-custom bg-white h-100">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-warning"><i class="bi bi-exclamation-circle me-2"></i>Incoming Direct Swap Requests (@Model.IncomingSwaps.Count)</h6>
            </div>
            <div class="card-body">
                @if (!Model.IncomingSwaps.Any())
                {
                    <p class="text-muted small mb-0">No incoming swap requests at the moment.</p>
                }
                else
                {
                    foreach (var swap in Model.IncomingSwaps)
                    {
                        <div class="border rounded p-3 mb-3" id="swap-card-@swap.SwapRequestId">
                            <div class="d-flex justify-content-between">
                                <strong>@swap.RequesterUser?.FullName</strong>
                                <small class="text-muted">@swap.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                            </div>
                            <p class="small text-muted mb-1">
                                Wants you to cover <strong>@swap.OriginalDuty?.Exam?.CourseName (@swap.OriginalDuty?.Exam?.CourseCode)</strong>
                                on @swap.OriginalDuty?.Exam?.ExamDate.ToString("MMM dd") (@swap.OriginalDuty?.Exam?.StartTime).
                            </p>
                            @if (!string.IsNullOrEmpty(swap.Reason))
                            {
                                <p class="small fst-italic text-secondary mb-2">"@swap.Reason"</p>
                            }
                            <div class="d-flex gap-2">
                                <button type="button" onclick="respondSwap(@swap.SwapRequestId, 'Accept')" class="btn btn-sm btn-success px-3">Accept Swap</button>
                                <button type="button" onclick="respondSwap(@swap.SwapRequestId, 'Decline')" class="btn btn-sm btn-outline-danger px-3">Decline</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card card-custom bg-white h-100">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0 text-secondary"><i class="bi bi-clock-history me-2"></i>My Swap History</h6>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (!Model.SwapHistory.Any())
                    {
                        <li class="list-group-item text-muted small">No completed swap logs yet.</li>
                    }
                    else
                    {
                        foreach (var hist in Model.SwapHistory)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="fw-bold">@hist.OriginalDuty?.Exam?.CourseName (@hist.RequesterUser?.FullName)</small><br>
                                    <small class="text-muted">@hist.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                <span class="badge @(hist.Status == "Accepted" ? "bg-success" : "bg-danger")">@hist.Status</span>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Request Duty Swap Modal (Submitted via $.ajax) -->
<div class="modal fade" id="requestSwapModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="requestSwapForm">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Initiate Duty Swap</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="OriginalDutyId" id="modalDutyId" />
                    <p class="small text-muted">Requesting swap for: <strong id="modalCourseTitle"></strong></p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Swap Type</label>
                        <select name="SwapType" id="swapTypeSelect" class="form-select" onchange="toggleColleagueSelect()">
                            <option value="direct">Direct Swap (Select specific colleague)</option>
                            <option value="open">Post to Open Department Swap Board</option>
                        </select>
                    </div>
                    <div class="mb-3" id="colleagueDiv">
                        <label class="form-label fw-semibold">Select Colleague</label>
                        <select name="TargetUserId" class="form-select">
                            @foreach (var col in Model.Colleagues)
                            {
                                <option value="@col.Id">@col.FullName (@col.EmployeeOrRollNumber)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason for Swap Request</label>
                        <textarea name="Reason" class="form-control" rows="2" placeholder="Briefly state your schedule conflict..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Open Swap Board Modal -->
<div class="modal fade" id="openSwapBoardModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Department Open Duty Swap Board</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Unclaimed duty swap requests posted by colleagues across the department.</p>
                <div class="list-group">
                    @if (!Model.OpenSwapBoard.Any())
                    {
                        <div class="text-muted small py-3 text-center">No open swap requests available right now.</div>
                    }
                    else
                    {
                        foreach (var openSwap in Model.OpenSwapBoard)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center" id="open-swap-@openSwap.SwapRequestId">
                                <div>
                                    <strong>@openSwap.OriginalDuty?.Exam?.CourseName (@openSwap.OriginalDuty?.Exam?.CourseCode)</strong>
                                    • @openSwap.OriginalDuty?.Exam?.ExamDate.ToString("MMM dd") (@openSwap.OriginalDuty?.Exam?.StartTime)<br>
                                    <small class="text-muted">Posted by: @openSwap.RequesterUser?.FullName • Venue: @openSwap.OriginalDuty?.Exam?.Venue</small>
                                </div>
                                <button type="button" onclick="respondSwap(@openSwap.SwapRequestId, 'Accept')" class="btn btn-sm btn-outline-success">Claim Duty</button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openSwapModal(dutyId, courseTitle) {
            $('#modalDutyId').val(dutyId);
            $('#modalCourseTitle').text(courseTitle);
        }

        function toggleColleagueSelect() {
            const type = $('#swapTypeSelect').val();
            $('#colleagueDiv').toggle(type !== 'open');
        }

        // $.ajax - Submit Swap Request
        $('#requestSwapForm').on('submit', function (e) {
            e.preventDefault();
            const dutyId = $('#modalDutyId').val();

            $.ajax({
                type: 'POST',
                url: '/Faculty/RequestSwapAjax',
                data: $(this).serialize(),
                success: function (res) {
                    if (res.success) {
                        $('#requestSwapModal').modal('hide');
                        $(`#status-cell-${dutyId}`).html('<span class="badge badge-status-pending">Swap Requested</span>');
                        $(`#action-cell-${dutyId}`).html('<button class="btn btn-sm btn-outline-secondary" disabled>Swap Pending...</button>');
                        $('#facultyAlertText').text(res.message);
                        $('#facultyAlert').removeClass('d-none');
                    } else {
                        alert(res.message);
                    }
                }
            });
        });

        // $.post - Accept or Decline Swap
        function respondSwap(swapRequestId, decision) {
            $.post('/Faculty/RespondSwapAjax', { swapRequestId: swapRequestId, decision: decision }, function (res) {
                if (res.success) {
                    $(`#swap-card-${swapRequestId}`).fadeOut(300, function () { $(this).remove(); });
                    $(`#open-swap-${swapRequestId}`).fadeOut(300, function () { $(this).remove(); });
                    $('#facultyAlertText').text(res.message);
                    $('#facultyAlert').removeClass('d-none');

                    if (decision === 'Accept') {
                        setTimeout(() => location.reload(), 1200);
                    }
                }
            });
        }
    </script>
}