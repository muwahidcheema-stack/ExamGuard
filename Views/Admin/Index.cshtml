@model ExamGuard.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div id="ajaxAlert" class="alert alert-success alert-dismissible fade show d-none small" role="alert">
    <span id="ajaxAlertText"></span>
    <button type="button" class="btn-close" onclick="$('#ajaxAlert').addClass('d-none')"></button>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Department Admin Dashboard</h3>
        <p class="text-muted small">Manage master exam schedules, duty assignments, and duty swaps</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createExamModal">
            <i class="bi bi-plus-lg me-1"></i>New Exam Slot
        </button>
        <form asp-action="PublishAll" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-success"><i class="bi bi-send me-1"></i>Publish All</button>
        </form>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-custom p-3 bg-white">
            <div class="text-muted small">Total Exams Scheduled</div>
            <h3 class="fw-bold my-1">@Model.TotalExams</h3>
            <span class="text-success small"><i class="bi bi-check-circle me-1"></i>Active Series</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 bg-white">
            <div class="text-muted small">Assigned Invigilators</div>
            <h3 class="fw-bold my-1">@Model.TotalDuties</h3>
            <span class="text-primary small">@Model.StaffMembers.Count Registered Staff</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 bg-white">
            <div class="text-muted small">Pending Duty Swaps</div>
            <h3 class="fw-bold my-1 text-warning">@Model.PendingSwaps</h3>
            <span class="text-muted small">Awaiting Peer Response</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 bg-white">
            <div class="text-muted small">Coverage Status</div>
            <h3 class="fw-bold my-1 text-success">@(Model.TotalExams > 0 ? "100%" : "0%")</h3>
            <span class="text-success small">Slots Covered</span>
        </div>
    </div>
</div>

<!-- Master Duty Assignment Table with $.get Live Search -->
<div class="card card-custom bg-white mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Master Exam Schedule & Duty Allocations</h5>
        <div class="input-group input-group-sm w-25">
            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
            <input type="text" id="liveSearchInput" class="form-control" placeholder="Live search ($.get)...">
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Course Code & Name</th>
                    <th>Date & Time</th>
                    <th>Venue</th>
                    <th>Assigned Invigilator</th>
                    <th>Visibility</th>
                    <th>Duty Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="dutiesTableBody">
                @if (!Model.Duties.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No exam duties scheduled yet.</td></tr>
                }
                else
                {
                    foreach (var duty in Model.Duties)
                    {
                        <tr id="duty-row-@duty.DutyId">
                            <td><strong>@duty.Exam?.CourseCode</strong> - @duty.Exam?.CourseName</td>
                            <td>
                                @duty.Exam?.ExamDate.ToString("MMM dd, yyyy")<br>
                                <small class="text-muted">@duty.Exam?.StartTime - @duty.Exam?.EndTime</small>
                            </td>
                            <td><span class="badge bg-secondary">@duty.Exam?.Venue</span></td>
                            <td>@duty.AssignedUser?.FullName <small class="text-muted">(@duty.AssignedUser?.EmployeeOrRollNumber)</small></td>
                            <td>
                                <button type="button" onclick="togglePublish(@duty.ExamId, this)"
                                        class="btn btn-sm @(duty.Exam?.IsPublished == true ? "btn-success" : "btn-outline-secondary")">
                                    @(duty.Exam?.IsPublished == true ? "Published" : "Unpublished")
                                </button>
                            </td>
                            <td>
                                @if (duty.Status == "SwapRequested")
                                {
                                    <span class="badge badge-status-pending">Swap Pending</span>
                                }
                                else
                                {
                                    <span class="badge badge-status-assigned">@duty.Status</span>
                                }
                            </td>
                            <td>
                                <button type="button" onclick="deleteDuty(@duty.DutyId)" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Exam Modal (Submitted via $.ajax) -->
<div class="modal fade" id="createExamModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createExamForm">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Schedule New Exam Duty</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Course Title</label>
                        <input type="text" name="CourseName" class="form-control" placeholder="e.g. Web Technologies" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Course Code</label>
                            <input type="text" name="CourseCode" class="form-control" placeholder="CS301" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Venue</label>
                            <input type="text" name="Venue" class="form-control" placeholder="Lab 2 / Hall A" required>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Exam Date</label>
                            <input type="date" name="ExamDate" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Start Time</label>
                            <input type="text" name="StartTime" class="form-control" placeholder="09:00 AM" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">End Time</label>
                            <input type="text" name="EndTime" class="form-control" placeholder="11:30 AM" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Assign Invigilator</label>
                        <select name="AssignedUserId" class="form-select" required>
                            <option value="">Select Staff Member...</option>
                            @foreach (var staff in Model.StaffMembers)
                            {
                                <option value="@staff.Id">@staff.FullName (@staff.EmployeeOrRollNumber)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save & Assign</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showBanner(msg) {
            $('#ajaxAlertText').text(msg);
            $('#ajaxAlert').removeClass('d-none');
        }

        // 1. $.get - Live Search Table
        $('#liveSearchInput').on('keyup', function () {
            const term = $(this).val();
            $.get('/Admin/SearchDuties', { query: term }, function (data) {
                const tbody = $('#dutiesTableBody');
                tbody.empty();

                if (data.length === 0) {
                    tbody.append('<tr><td colspan="7" class="text-center text-muted py-4">No matching records found.</td></tr>');
                    return;
                }

                data.forEach(item => {
                    const pubBtnClass = item.isPublished ? 'btn-success' : 'btn-outline-secondary';
                    const pubText = item.isPublished ? 'Published' : 'Unpublished';
                    const statusBadge = item.status === 'SwapRequested'
                        ? '<span class="badge badge-status-pending">Swap Pending</span>'
                        : `<span class="badge badge-status-assigned">${item.status}</span>`;

                    tbody.append(`
                        <tr id="duty-row-${item.dutyId}">
                            <td><strong>${item.courseCode}</strong> - ${item.courseName}</td>
                            <td>${item.examDate}<br><small class="text-muted">${item.timeSlot}</small></td>
                            <td><span class="badge bg-secondary">${item.venue}</span></td>
                            <td>${item.assignedUserName} <small class="text-muted">(${item.rollNo})</small></td>
                            <td>
                                <button type="button" onclick="togglePublish(${item.examId}, this)" class="btn btn-sm ${pubBtnClass}">${pubText}</button>
                            </td>
                            <td>${statusBadge}</td>
                            <td>
                                <button type="button" onclick="deleteDuty(${item.dutyId})" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    `);
                });
            });
        });

        // 2. $.ajax - Create Exam & Assign Duty
        $('#createExamForm').on('submit', function (e) {
            e.preventDefault();
            $.ajax({
                type: 'POST',
                url: '/Admin/CreateExamAjax',
                data: $(this).serialize(),
                success: function (res) {
                    if (res.success) {
                        $('#createExamModal').modal('hide');
                        $('#createExamForm')[0].reset();
                        showBanner(res.message);
                        $('#liveSearchInput').trigger('keyup'); // Refresh table via $.get
                    } else {
                        alert(res.message);
                    }
                }
            });
        });

        // 3. $.post - Toggle Publish Status
        function togglePublish(examId, btn) {
            $.post('/Admin/TogglePublishAjax', { examId: examId }, function (res) {
                if (res.success) {
                    const $btn = $(btn);
                    if ($btn.hasClass('btn-success')) {
                        $btn.removeClass('btn-success').addClass('btn-outline-secondary').text('Unpublished');
                    } else {
                        $btn.removeClass('btn-outline-secondary').addClass('btn-success').text('Published');
                    }
                    showBanner('Exam publish visibility updated!');
                }
            });
        }

        // 4. $.post - Delete Duty Row
        function deleteDuty(dutyId) {
            if (!confirm('Delete this exam slot?')) return;
            $.post('/Admin/DeleteDutyAjax', { dutyId: dutyId }, function (res) {
                if (res.success) {
                    $(`#duty-row-${dutyId}`).fadeOut(300, function () { $(this).remove(); });
                    showBanner('Exam slot deleted.');
                }
            });
        }
    </script>
}