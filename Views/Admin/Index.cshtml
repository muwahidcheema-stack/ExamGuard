@model ExamGuard.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Department Admin Dashboard</h3>
        <p class="text-muted small">Manage master exam schedules, duty assignments, and duty swaps</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createExamModal">
            <i class="bi bi-plus-lg me-1"></i>New Exam Slot
        </button>
        <form asp-action="PublishAll" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-success"><i class="bi bi-send me-1"></i>Publish Roster</button>
        </form>
    </div>
</div>

<!-- Dynamic Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-custom p-3 bg-white">
            <div class="text-muted small">Total Exams Scheduled</div>
            <h3 class="fw-bold my-1">@Model.TotalExams</h3>
            <span class="text-success small"><i class="bi bi-check-circle me-1"></i>Active Series</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 bg-white">
            <div class="text-muted small">Assigned Invigilators</div>
            <h3 class="fw-bold my-1">@Model.TotalDuties</h3>
            <span class="text-primary small">@Model.StaffMembers.Count Registered Staff</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 bg-white">
            <div class="text-muted small">Pending Duty Swaps</div>
            <h3 class="fw-bold my-1 text-warning">@Model.PendingSwaps</h3>
            <span class="text-muted small">Awaiting Peer Response</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 bg-white">
            <div class="text-muted small">Coverage Status</div>
            <h3 class="fw-bold my-1 text-success">@(Model.TotalExams > 0 ? "100%" : "0%")</h3>
            <span class="text-success small">Slots Covered</span>
        </div>
    </div>
</div>

<!-- Master Duty Assignment Table -->
<div class="card card-custom bg-white mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0">Master Exam Schedule & Duty Allocations</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Course Code & Name</th>
                    <th>Date & Time</th>
                    <th>Venue</th>
                    <th>Assigned Invigilator</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Duties.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No exam duties scheduled yet. Click "New Exam Slot" to add one.</td></tr>
                }
                else
                {
                    foreach (var duty in Model.Duties)
                    {
                        <tr>
                            <td><strong>@duty.Exam?.CourseCode</strong> - @duty.Exam?.CourseName</td>
                            <td>
                                @duty.Exam?.ExamDate.ToString("MMM dd, yyyy")<br>
                                <small class="text-muted">@duty.Exam?.StartTime - @duty.Exam?.EndTime</small>
                            </td>
                            <td><span class="badge bg-secondary">@duty.Exam?.Venue</span></td>
                            <td>@duty.AssignedUser?.FullName <small class="text-muted">(@duty.AssignedUser?.EmployeeOrRollNumber)</small></td>
                            <td>
                                @if (duty.Status == "SwapRequested")
                                {
                                    <span class="badge badge-status-pending">Swap Pending</span>
                                }
                                else
                                {
                                    <span class="badge badge-status-assigned">@duty.Status</span>
                                }
                            </td>
                            <td>
                                <form asp-action="DeleteDuty" method="post" class="d-inline" onsubmit="return confirm('Delete this exam slot?');">
                                    <input type="hidden" name="dutyId" value="@duty.DutyId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Exam Modal -->
<div class="modal fade" id="createExamModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateExamAndDuty" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Schedule New Exam Duty</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Course Title</label>
                        <input type="text" name="CourseName" class="form-control" placeholder="e.g. Web Technologies" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Course Code</label>
                            <input type="text" name="CourseCode" class="form-control" placeholder="CS301" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Venue</label>
                            <input type="text" name="Venue" class="form-control" placeholder="Lab 2 / Hall A" required>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Exam Date</label>
                            <input type="date" name="ExamDate" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Start Time</label>
                            <input type="text" name="StartTime" class="form-control" placeholder="09:00 AM" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">End Time</label>
                            <input type="text" name="EndTime" class="form-control" placeholder="11:30 AM" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Assign Invigilator</label>
                        <select name="AssignedUserId" class="form-select" required>
                            <option value="">Select Staff Member...</option>
                            @foreach (var staff in Model.StaffMembers)
                            {
                                <option value="@staff.Id">@staff.FullName (@staff.EmployeeOrRollNumber)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save & Assign</button>
                </div>
            </form>
        </div>
    </div>
</div>